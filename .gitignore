.cursor/
.history/

# Generated release and updater artifacts
/pacs-assistant.exe
/pacs-assistant.new.exe
/pacs-assistant.backup.exe
/AutoHotkey-v*-source.zip

# Isolated development worktrees
/.worktrees/
